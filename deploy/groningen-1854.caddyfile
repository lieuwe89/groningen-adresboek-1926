groningen-1854.lieuwejongsma.nl {
	encode zstd gzip

	# Scan tiles are immutable; serve them straight from the data volume.
	# Caddy needs read access: sudo chmod -R o+rX /srv/data/groningen-1854/tiles /srv/data/groningen-1854/maps
	handle_path /tiles/* {
		root * /srv/data/groningen-1854/tiles
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# The 1832 cadastre layers get replaced when the extraction improves: cache for a day, not forever.
	handle_path /maps/* {
		root * /srv/data/groningen-1854/maps
		header Cache-Control "public, max-age=86400"
		file_server
	}

	handle {
		reverse_proxy localhost:3007 {
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Port 443

			# Next.js standalone builds absolute redirects with its internal bind port (3000).
			header_down Location "^http://groningen-1854\.lieuwejongsma\.nl:3000(.*)$" "https://groningen-1854.lieuwejongsma.nl$1"
		}
	}
}
