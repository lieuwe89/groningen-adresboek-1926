groningen-1926.lieuwejongsma.nl {
	encode zstd gzip

	# Map tiles and COG basemaps are immutable files on the data volume.
	# Serve them straight from Caddy so the Node container never sees the
	# request bursts from map pan/zoom. Host paths mirror the container
	# symlinks (/data/tiles, /data/maps). Caddy needs read access:
	# sudo chmod -R o+rX /srv/data/groningen-1926/tiles /srv/data/groningen-1926/maps
	handle_path /tiles/* {
		root * /srv/data/groningen-1926/tiles
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle_path /maps/* {
		root * /srv/data/groningen-1926/maps
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		reverse_proxy localhost:3003 {
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Port 443

			# Next.js standalone server builds absolute redirects using its
			# internal bind port (3000). Rewrite Location back to the public
			# https origin so the browser doesn't follow to :3000.
			header_down Location "^http://groningen-1926\.lieuwejongsma\.nl:3000(.*)$" "https://groningen-1926.lieuwejongsma.nl$1"
		}
	}
}
