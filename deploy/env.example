# --- groningen-1926 VPS env (copy to .env, mode 600) ---

# Paths on the data volume (mounted at /data by docker-compose).
DB_PATH=/data/adresboek.sqlite
JSON_DIR=/data/json
OVERRIDES_DIR=/data/overrides

# Admin login (used by app/api/admin/login).
# Set via secrets — never commit values.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
# 64-hex session signing secret. Generate with: openssl rand -hex 32
ADMIN_SECRET=change-me

# Optional asset base URLs. Leave empty to serve tiles/maps from the
# container's own /public symlinks (default for self-hosted VPS).
# NEXT_PUBLIC_TILES_BASE_URL=
# NEXT_PUBLIC_MAPS_BASE_URL=
# NEXT_PUBLIC_STATIC_ASSETS_BASE_URL=
