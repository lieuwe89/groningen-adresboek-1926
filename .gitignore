# OS
.DS_Store
Thumbs.db

# Project secrets — NEVER commit
.env
.env.*
!.env.local.example

# Internal pipeline generated assets
_pipeline/.venv/
_pipeline/Maps/
_pipeline/output/
_pipeline/scans/
_pipeline/tessdata/
_pipeline/pipeline/config_local.py
_pipeline/**/*.pyc

# Next.js / Node
node_modules/
.next/
out/
*.tsbuildinfo
next-env.d.ts
.vercel
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Documentation & Markdown
*.md
!/README.md
!/CHANGELOG.md
!/deploy/README.md
/docs/*
!/docs/sync-overrides.md

# Application Data
# Use /data/* (not data/) so the dir itself isn't excluded — that would
# block re-including data/overrides/. See man gitignore.
/data/*
!/data/overrides/
public/tiles/
public/maps/

# Python (if any left in root)
__pycache__/
*.pyc
.venv/

# Drive sync transient state
.tmp.driveupload/
.tmp.drivedownload/
.tmp.*
