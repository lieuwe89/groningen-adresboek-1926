# Project secrets — NEVER commit
pipeline/config_local.py
secrets.md
.env
.env.*
!web/.env.local.example

# Generated pipeline outputs (rebuildable from cached OCR + LLM raw + scans)
# Override for `output/overrides/` — those are user-edited corrections, not generated.
output/*
!output/overrides/

# Large source assets — synced via Drive / external transfer, NOT committed.
# To set up a working clone: copy these directories into place from the
# original storage. See README.md "Required external assets" for sources.
scans/
Maps/
tessdata/

# Drive sync transient state
.tmp.driveupload/
.tmp.drivedownload/
.tmp.*

# Editor / tooling
.claude/
.idea/
.vscode/

